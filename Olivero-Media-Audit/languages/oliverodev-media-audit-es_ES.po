#. translators: 1: number of unused files, 2: formatted size
#: includes/class-muc-admin.php:1316
#, php-format
msgid ""
"We found %1$s unused files (%2$s) taking up space. You have used all your "
"free deletions. Upgrade to PRO to delete everything and unlock bulk cleanup."
msgstr ""
"Encontramos %1$s archivos sin uso (%2$s) ocupando espacio. Has agotado tus "
"eliminaciones gratuitas. Mejora a PRO para eliminar todo y desbloquear la "
"limpieza masiva."

#: includes/class-muc-admin.php:1321
msgid ""
"You have used all your free deletions. Upgrade to PRO to clean your library "
"with unlimited deletion and advanced features."
msgstr ""
"Has agotado tus eliminaciones gratuitas. Mejora a PRO para limpiar tu "
"biblioteca con eliminación ilimitada y funciones avanzadas."

#: includes/class-muc-admin.php:1330
msgid "Unlimited Deletion — No limits, no caps"
msgstr "Eliminación ilimitada: sin límites ni tope"

#: includes/class-muc-admin.php:1331
msgid ""
"FREE lets you delete up to 15 files. PRO removes the limit — delete every "
"unused file in one click."
msgstr ""
"GRATIS te permite eliminar hasta 15 archivos. PRO elimina el límite: elimina "
"todos los archivos sin uso con un clic."

#: includes/class-muc-admin.php:1337
msgid "Deep Detection for Elementor, ACF, Divi & WooCommerce"
msgstr "Detección profunda para Elementor, ACF, Divi y WooCommerce"

#: includes/class-muc-admin.php:1338
msgid ""
"Catches every hidden reference the free scanner misses — so you never delete "
"a file your site still needs."
msgstr ""
"Detecta cada referencia oculta que el escáner gratuito no ve, para que nunca "
"elimines un archivo que tu sitio todavía necesita."

#: includes/class-muc-admin.php:1344
msgid "Risk Score 0–100 per file"
msgstr "Puntuación de riesgo 0–100 por archivo"

#: includes/class-muc-admin.php:1345
msgid ""
"Know exactly how safe it is to delete each file — based on age, references, "
"metadata, and filename patterns."
msgstr ""
"Sabrás exactamente qué tan seguro es eliminar cada archivo, según la "
"antigüedad, las referencias, los metadatos y los patrones del nombre."

#: includes/class-muc-admin.php:1351
msgid "PRO Trash: delete with an undo button"
msgstr "Papelera PRO: elimina con un botón de deshacer"

#: includes/class-muc-admin.php:1352
msgid ""
"Move files to PRO Trash first. Restore them in one click if you change your "
"mind."
msgstr ""
"Primero mueve los archivos a la Papelera PRO. Restáuralos con un clic si "
"cambias de opinión."

#: includes/class-muc-admin.php:1358
msgid "Analytics & CSV Export"
msgstr "Analíticas y exportación CSV"

#: includes/class-muc-admin.php:1359
msgid ""
"Storage breakdown charts, risk distribution, and full CSV export of all "
"unused files."
msgstr ""
"Gráficos de desglose de almacenamiento, distribución de riesgo y exportación "
"CSV completa de todos los archivos sin uso."

#: includes/class-muc-admin.php:1365
msgid "Bulk Cleanup & Email Reports"
msgstr "Limpieza masiva e informes por correo"

#: includes/class-muc-admin.php:1366
msgid ""
"Clean by risk level in one click. Get weekly email summaries for every site "
"you manage."
msgstr ""
"Limpia por nivel de riesgo con un clic. Recibe resúmenes semanales por correo "
"para cada sitio que administres."

